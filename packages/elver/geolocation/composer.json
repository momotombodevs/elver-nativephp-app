{
    "name": "elver/geolocation",
    "version": "1.0.0",
    "description": "Foreground geolocation bridge for the Elver NativePHP Mobile app",
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Elver\\Geolocation\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Elver\\Geolocation\\ElverGeolocationServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
