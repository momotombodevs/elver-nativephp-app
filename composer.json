{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "donmanuel/elver",
    "type": "project",
    "description": "Elver, a local-first climate companion built with NativePHP Mobile.",
    "keywords": [
        "laravel",
        "framework",
        "nativephp",
        "mobile"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/agroclima/geolocation",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/agroclima/climate-notifications",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "nativephp-plugins",
            "type": "composer",
            "url": "https://plugins.nativephp.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "agroclima/climate-notifications": "^1.0",
        "agroclima/geolocation": "^1.0",
        "donmanueldev/nativephp-charts": "^1.2",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "nativephp/mobile": "^4.0",
        "nativephp/mobile-browser": "^1.0",
        "nativephp/mobile-ui": "^0.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi",
            "@php artisan native:install"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
